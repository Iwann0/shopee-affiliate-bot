# Twitter API Credentials (required — for auth + analytics only)
TWITTER_API_KEY=your_api_key
TWITTER_API_SECRET=your_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret
TWITTER_BEARER_TOKEN=your_bearer_token

# Niche keywords (comma-separated) — topics to research
NICHE_KEYWORDS=tech,programming,AI,startup,crypto

# Scheduling intervals (minutes)
ENGAGE_INTERVAL_MINUTES=30
POST_INTERVAL_MINUTES=120
ANALYTICS_INTERVAL_MINUTES=720

# Tweet draft count per research cycle
DRAFT_COUNT=5

# Analytics storage
ANALYTICS_FILE=analytics.json
