# Twitter API Credentials (required)
TWITTER_API_KEY=your_api_key
TWITTER_API_SECRET=your_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret
TWITTER_BEARER_TOKEN=your_bearer_token

# Niche keywords (comma-separated) — topics to engage with
NICHE_KEYWORDS=tech,programming,AI,startup,crypto

# Rate limits per hour (keep low to avoid Twitter bans)
MAX_LIKES_PER_HOUR=15
MAX_RETWEETS_PER_HOUR=10
MAX_REPLIES_PER_HOUR=5
MAX_FOLLOWS_PER_HOUR=10

# Content filters
ENGAGEMENT_MIN_FOLLOWERS=100
ENGAGEMENT_MIN_LIKES=5

# Follow/unfollow settings
UNFOLLOW_AFTER_DAYS=3
MAX_FOLLOWING_RATIO=1.5

# Scheduling intervals (minutes)
ENGAGE_INTERVAL_MINUTES=30
POST_INTERVAL_MINUTES=120
FOLLOW_INTERVAL_MINUTES=60
UNFOLLOW_INTERVAL_MINUTES=360
ANALYTICS_INTERVAL_MINUTES=720
